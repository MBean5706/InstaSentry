{
  "manifest_version": 3,
  "name": "InstaSentry Beta",
  "version": "1.0",
  "description": "InstaSentry side panel mock UI.",
  "permissions": ["sidePanel", "downloads"],
  "host_permissions": ["http://127.0.0.1:5000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "InstaSentry"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
